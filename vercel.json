{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{admin,chatbot,config,database,includes,vendor}/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.php"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/api/index.php"
    }
  ]
}